<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Manifest derived from Apollo-DuerOS CarLife-Android-Vehicle-V2.0/carlife-sdk
      (Apache-2.0). The package attribute moved to the Gradle namespace
      (com.baidu.carlife.sdk) per modern AGP requirements.
      Storage permissions are legacy upstream declarations; modern Android
      ignores them for app-scoped storage and DiPlay does not rely on them.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bluetooth (Phase 9.2W-B1 permission model): legacy install-time
         permissions only up to Android 11; Android 12+ uses the runtime
         BLUETOOTH_CONNECT grant (bonded-device lookup + RFCOMM connect).
         BLUETOOTH_SCAN is deliberately NOT declared - the modern CarLife
         bootstrap performs no discovery/scanning. DiPlay never requests the
         legacy location permissions for this path. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 14+ connectedDevice FGS runtime prerequisite (normal permission);
         satisfies the foreground-start requirement before any USB permission flow. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- foregroundServiceType: Android 14+ requires an explicit type; this is a
             device-connection session service (USB AOA phone link). -->
        <service
            android:name=".receiver.CarLifeReceiverService"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
